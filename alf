#include <stdio.h>
#include <string.h>


typedef struct {
  char nome[TAM_NOME];
  char cor[TAM_COR];
  int tropas;
} Territorio;

void cadastrarTerritorios(Territorio t[]) {
  for (int i = 0; i < MAX; i++) {
    printf("\nTerritório %d\n", i + 1);
    printf("Nome: ");
    fgets(t[i].nome, TAM_NOME, stdin);
    t[i].nome[strcspn(t[i].nome, "\n")] = '\0'; // remove \n

    printf("Cor do Exército: ");
    fgets(t[i].cor, TAM_COR, stdin);
    t[i].cor[strcspn(t[i].cor, "\n")] = '\0';

    printf("Número de Tropas: ");
    scanf("%d", &t[i].tropas);
    getchar(); // limpa o buffer
  }
}

void exibirMapa(const Territorio t[]) {
  printf("\n📍 Estado Atual do Mapa:\n");
  for (int i = 0; i < MAX; i++) {
    printf("T%d - %s | Cor: %s | Tropas: %d\n", i + 1, t[i].nome, t[i].cor, t[i].tropas);
  }
}

int main() {
  Territorio territorios[MAX];
  cadastrarTerritorios(territorios);
  exibirMapa(territorios);
  return 0;
}
